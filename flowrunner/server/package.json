{
  "name": "flowrunner-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --import tsx/esm scripts/migrate.ts"
  },
  "dependencies": {
    "fastify": "^4.27",
    "@fastify/cors": "^9.0",
    "@fastify/swagger": "^8.14",
    "@fastify/swagger-ui": "^3.0",
    "@fastify/rate-limit": "^9.1",
    "bullmq": "^5.8",
    "ioredis": "^5.3",
    "postgres": "^3.4",
    "zod": "^3.23",
    "envalid": "^8.0",
    "pino": "^9.2",
    "uuid": "^9.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/uuid": "^9",
    "@typescript-eslint/eslint-plugin": "^7.0",
    "@typescript-eslint/parser": "^7.0",
    "eslint": "^8.57",
    "tsx": "^4.15",
    "typescript": "^5.4",
    "vitest": "^1.6"
  }
}
