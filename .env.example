# OpenRouter — https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentcore
FLOWRUNNER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowrunner

# Redis
REDIS_URL=redis://localhost:6379

# Security — generate with: openssl rand -hex 32
AGENTCORE_API_KEY=
FLOWRUNNER_API_KEY=

# CORS — allowed origin for AgentCore (FlowRunner dev server)
FLOWRUNNER_ORIGIN=http://localhost:5173

# AgentCore URL used by FlowRunner's ai-agent node
# Docker: http://agentcore:8000  |  Local dev: http://localhost:8000
AGENTCORE_ORIGIN=http://agentcore:8000

# Agent limits
DEFAULT_MAX_ITERATIONS=10
DEFAULT_BUDGET_USD=0.10
DEFAULT_MAX_TOKENS=4000
